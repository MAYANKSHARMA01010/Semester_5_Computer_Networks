worker_processes 1;
pid nginx.pid;
error_log error.log;

events {
    worker_connections 128;
}

http {
    access_log access.log;
    upstream backend_pool {
        server 127.0.0.1:@A_PORT@ max_fails=1 fail_timeout=5s;
        server @B_IP@:@B_PORT@ max_fails=1 fail_timeout=5s;
    }

    server {
        listen @HTTPS_PORT@ ssl;
        server_name @APP_DOMAIN@ @API_DOMAIN@;
        ssl_certificate team1.crt;
        ssl_certificate_key team1.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        add_header X-Edge standby-mac3 always;

        location / {
            proxy_pass http://backend_pool;
            proxy_connect_timeout 2s;
            proxy_read_timeout 5s;
            proxy_next_upstream error timeout http_502 http_503 http_504;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
